<Window x:Class="RGTools.App.Views.DashboardView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RGTools" Height="320" Width="360"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>
        <SolidColorBrush x:Key="BgDark" Color="#121212"/>
        <SolidColorBrush x:Key="Accent" Color="#00A2FF"/>
        <SolidColorBrush x:Key="TextMain" Color="#E1E1E1"/>
        <SolidColorBrush x:Key="TextMuted" Color="#888888"/>
        <SolidColorBrush x:Key="StatusOff" Color="#FF4B4B"/>
        <SolidColorBrush x:Key="StatusOn" Color="#4CC94C"/>

        <Style x:Key="DashboardButtonBase" TargetType="Button">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="StatusButton" TargetType="Button" BasedOn="{StaticResource DashboardButtonBase}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="8" BorderBrush="#333" BorderThickness="1">
                            <Grid Margin="15,0">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource StatusOff}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#2D2D30"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="ON">
                                <Setter TargetName="StatusDot" Property="Fill" Value="{StaticResource StatusOn}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource DashboardButtonBase}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="8" BorderBrush="#333" BorderThickness="1">
                            <Grid Margin="15,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                               Foreground="{StaticResource Accent}" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="14"/>
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#2D2D30"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernToggle" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <BulletDecorator Background="Transparent" Cursor="Hand">
                            <BulletDecorator.Bullet>
                                <Grid Width="36" Height="18">
                                    <Border x:Name="Bg" Background="#333" CornerRadius="9"/>
                                    <Ellipse x:Name="Thumb" Width="12" Height="12" Fill="White" HorizontalAlignment="Left" Margin="3,0"/>
                                </Grid>
                            </BulletDecorator.Bullet>
                            <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </BulletDecorator>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource StatusOn}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BgDark}" CornerRadius="16" BorderBrush="#2A2A2A" BorderThickness="1">
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,25">
                <TextBlock Text="RGTOOLS" Foreground="White" FontSize="14" FontWeight="Bold" Opacity="0.4"/>
                <Button x:Name="BtnTopClose" Content="✕" HorizontalAlignment="Right" Background="Transparent"
                        Foreground="#666" BorderThickness="0" FontSize="14" Click="BtnClose_Click"/>
            </Grid>

            <StackPanel Grid.Row="1">
                <TextBlock Text="SERVICIOS" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" Margin="0,0,0,12"/>
                <Button x:Name="BtnVpn" Content="Encender VPN" Style="{StaticResource StatusButton}" Click="BtnVpn_Click" Tag="OFF"/>
                <TextBlock x:Name="TxtVpnStatus"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Margin="5,-5,0,12"
                        Visibility="Collapsed"
                        Foreground="{StaticResource StatusOn}"/>

                <Button x:Name="BtnJumpbox"
                        Content="Crear Túnel DB"
                        Style="{StaticResource ActionButton}"
                        Tag="🖧"
                        Visibility="Collapsed"
                        Click="BtnJumpbox_Click"/>

                <Separator Background="#222" Margin="0,20,0,20" Height="1" BorderThickness="0"/>

                <TextBlock Text="SEGURIDAD" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" Margin="0,0,0,15"/>

                <CheckBox x:Name="ChkDns"
                          Content="Guardian DNS Activo"
                          Style="{StaticResource ModernToggle}"
                          Margin="0,0,0,15"
                          Click="ChkDns_Click"
                          Foreground="White"
                          FontSize="13"/>

                <CheckBox x:Name="ChkStartup"
                          Content="Iniciar con Windows"
                          Style="{StaticResource ModernToggle}"
                          Margin="0,0,0,5"
                          Click="ChkStartup_Click"
                          Foreground="White"
                          FontSize="13"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
